{
  "schema_version": 1,
  "about": "Sim codes → art ids (ADR 0033). The renderer reads every content name from here and from manifest.json; scripts/world/** names none. Codes are the bridge contracts documented in docs/v8/snapshot_schema.md. An unknown code draws its family's `fallback`.",
  "terrain": {
    "fallback": "dark_grass",
    "codes": [
      {"code": 0, "sim": "Plain", "ground": "dark_grass"},
      {"code": 1, "sim": "Forest", "ground": "forest_floor"},
      {"code": 2, "sim": "Mountain", "ground": "hill_rock", "standing_face": true, "blocks": true},
