(schema_version: 1, rules: [
 (id: 1, label: "MUX_STEWARD_RULE_1", scope: All, cooldown: 1440, condition: NoStockpile, action: Stockpile(base_cells: 6, divisor: 2)),
 (id: 2, label: "MUX_STEWARD_RULE_2", scope: All, cooldown: 360, condition: WoodDeficit, action: Wood(items: [Log], days: 12, camp_radius: 4, batch: 32, cap_log_margin: Some(20))),
 (id: 3, label: "MUX_STEWARD_RULE_3", scope: Housing, cooldown: 1440, condition: Unsheltered, action: House(wall: LogWall, door: Door, bed: Bedroll, max_beds: 16, service_cells: 8, completion_role: Some(Bedroom))),
 (id: 4, label: "MUX_STEWARD_RULE_4", scope: All, cooldown: 360, condition: Production, action: Bills(recipes: [(HaftAxe, 2), (KnapFineBlade, 4), (KnapBlade, 4)], winter_recipe: SplitFirewood, days: 0), extended: false, grace_ticks: None),
 (id: 5, label: "MUX_STEWARD_RULE_5", scope: Food, cooldown: 1440, condition: FoodDeficit, action: Hunt(item: Meat, animal: Deer, knowledge: "tracking", days: 3, radius: 5)),
 (id: 7, label: "MUX_STEWARD_RULE_7", scope: All, cooldown: 1, condition: ThreatApproaching, action: Defence(max_defenders: 4, min_hp: 50, release_tiles: 24, release_ticks: 60, protect_residents: true)),
 (id: 9, label: "MUX_STEWARD_RULE_9", scope: All, cooldown: 360, condition: Production, action: Bills(recipes: [], winter_recipe: SplitFirewood, days: 6, fuel: Some((warm_days: 3, prepare_season: 1, buffer_permille: 1250)))),
 (id: 10, label: "MUX_STEWARD_RULE_10", scope: Food, cooldown: 1440, condition: Unsheltered, action: House(wall: LogWall, door: Door, bed: Bedroll, max_beds: 16, service_cells: 8, completion_role: Some(Storehouse))),
 (id: 8, label: "M6A_STEWARD_FOOD", scope: Food, cooldown: 360, condition: FoodDeficit, action: FoodPlan((cultivation: Some((crop: Emmer, replacement_permille: 300, net_units_per_tile: 12, area_cap_permille: 1250, batch: 4)), adult_daily_milli: 2400, child_daily_milli: 1440, cold_multiplier: 1500, reserve_days: 2, reserve_start_day: 8, winter_season: 3, forage_radius: 16, harvest_batch: 16, cooked_days_milli: 1000, recipes: [Porridge, FruitPorridge, Stew, RoastMeat, RoastedRoots, DryMeat, DryBerries], vessel_recipes: [(FormPot, 2), (FirePot, 2)], winter_keep_days: 6))),
 // C1-b starting admission cadence, not a balance target; source range/lifecycle remain in animals.ron.
 (id: 11, label: "C1_STEWARD_LIVESTOCK", scope: Food, cooldown: 360, condition: Livestock, action: Livestock),
 // C2-b: one smelt once copper smelting is practised and copper ore is stockpiled; the missing smelter is requested through the ordinary placement path.
 (id: 12, label: "C2_STEWARD_SMELTER", scope: All, cooldown: 360, condition: Production, action: Bills(recipes: [(SmeltCopper, 1)], winter_recipe: SplitFirewood, days: 0, stocked: [CopperOre])),
 // C2-b: one cast axe per colonist still chopping with a stone-tagged axe; bronze first, copper as the fallback.
 (id: 13, label: "C2_STEWARD_AXES", scope: All, cooldown: 360, condition: Production, action: Bills(recipes: [(CastBronzeAxe, 1), (CastCopperAxe, 1)], winter_recipe: SplitFirewood, days: 0, replace_tag: Some("stone_tool"))),
])
