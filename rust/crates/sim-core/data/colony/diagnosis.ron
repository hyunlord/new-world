// Schema 1: read-only state diagnosis checks per subject kind.
// Predicates use the mind's operator set over named facts.
// Each check can chain to the next subject via `next`.
(schema_version: 1, subjects: [
    (kind: "person", checks: [
        (
            id: "person_starving",
            when: [(fact: "hunger_tenths", op: ">=", value: Some(750))],
            text_key: "DIAG_PERSON_STARVING",
            params: {"hunger_pct": "hunger_tenths"},
            severity: "danger",
            next: Some((kind: "stockpile", pick: "nearest_home")),
            tags: ["food"],
        ),
        (
            id: "person_hungry",
            when: [(fact: "hunger_tenths", op: ">=", value: Some(500))],
            text_key: "DIAG_PERSON_HUNGRY",
            params: {"hunger_pct": "hunger_tenths"},
            severity: "warning",
            next: Some((kind: "stockpile", pick: "nearest_home")),
            tags: ["food"],
        ),
        (
            id: "person_cold",
            when: [(fact: "cold", op: "has", value: None)],
            text_key: "DIAG_PERSON_COLD",
            params: {},
            severity: "warning",
            next: Some((kind: "hearth", pick: "home_hearth")),
            tags: ["warmth"],
        ),
        (
            id: "person_thirsty",
            when: [(fact: "thirst_tenths", op: ">=", value: Some(500))],
            text_key: "DIAG_PERSON_THIRSTY",
            params: {"thirst_pct": "thirst_tenths"},
            severity: "warning",
            next: None,
            tags: ["water"],
        ),
    ]),
    (kind: "stockpile", checks: [
        (
            id: "stockpile_no_food",
            when: [(fact: "food_stored", op: "==", value: Some(0))],
            text_key: "DIAG_STOCKPILE_NO_FOOD",
            params: {},
            severity: "danger",
            next: Some((kind: "settlement", pick: "parent")),
            tags: ["food"],
        ),
        (
            id: "stockpile_food_low",
            when: [(fact: "food_stored", op: "<", value: Some(10))],
            text_key: "DIAG_STOCKPILE_FOOD_LOW",
            params: {"food_count": "food_stored"},
            severity: "warning",
            next: Some((kind: "settlement", pick: "parent")),
            tags: ["food"],
        ),
        (
            id: "stockpile_not_arriving",
            when: [
                (fact: "ground_items_nearby", op: ">", value: Some(0)),
                (fact: "haulers_assigned", op: "==", value: Some(0)),
            ],
            text_key: "DIAG_STOCKPILE_NOT_ARRIVING",
            params: {"ground_count": "ground_items_nearby"},
            severity: "warning",
            next: Some((kind: "settlement", pick: "parent")),
            tags: ["hauling"],
        ),
        (
            id: "stockpile_full",
            when: [(fact: "free_cells", op: "==", value: Some(0))],
            text_key: "DIAG_STOCKPILE_FULL",
            params: {},
            severity: "notice",
            next: None,
            tags: ["storage"],
        ),
    ]),
    (kind: "hearth", checks: [
        (
            id: "hearth_no_fuel",
            when: [
                (fact: "lit", op: "not", value: None),
                (fact: "fuel_at_hearth", op: "==", value: Some(0)),
            ],
            text_key: "DIAG_HEARTH_NO_FUEL",
            params: {},
            severity: "danger",
            next: Some((kind: "settlement", pick: "parent")),
            tags: ["warmth"],
        ),
        (
            id: "hearth_unlit",
            when: [(fact: "lit", op: "not", value: None)],
            text_key: "DIAG_HEARTH_UNLIT",
            params: {},
            severity: "warning",
            next: Some((kind: "settlement", pick: "parent")),
            tags: ["warmth"],
        ),
        (
            id: "hearth_fuel_low",
            when: [(fact: "fuel_stock_days", op: "<", value: Some(2))],
            text_key: "DIAG_HEARTH_FUEL_LOW",
            params: {"fuel_days": "fuel_stock_days"},
            severity: "notice",
            next: Some((kind: "settlement", pick: "parent")),
            tags: ["warmth"],
        ),
    ]),
    (kind: "room", checks: [
        (
            id: "room_not_roofed",
            when: [(fact: "roofed", op: "not", value: None)],
            text_key: "DIAG_ROOM_NOT_ROOFED",
            params: {},
            severity: "warning",
            next: None,
            tags: ["shelter"],
        ),
        (
            id: "room_no_beds",
            when: [(fact: "bed_count", op: "==", value: Some(0))],
            text_key: "DIAG_ROOM_NO_BEDS",
            params: {},
            severity: "notice",
            next: None,
            tags: ["shelter"],
        ),
    ]),
    (kind: "settlement", checks: [
        (
            id: "settlement_no_food",
            when: [(fact: "food_stored", op: "==", value: Some(0))],
            text_key: "DIAG_SETTLEMENT_NO_FOOD",
            params: {},
            severity: "danger",
            next: None,
            tags: ["food"],
        ),
        (
            id: "settlement_winter_food_short",
            when: [(fact: "winter_food_short", op: "has", value: None)],
            text_key: "DIAG_SETTLEMENT_WINTER_FOOD_SHORT",
            params: {"food_stored": "food_stored", "winter_need": "winter_need"},
            severity: "danger",
            next: None,
            tags: ["food", "winter"],
        ),
        (
            id: "settlement_food_low",
            when: [(fact: "food_stored", op: "<", value: Some(20))],
            text_key: "DIAG_SETTLEMENT_FOOD_LOW",
            params: {"food_count": "food_stored"},
            severity: "warning",
            next: None,
            tags: ["food"],
        ),
        (
            id: "settlement_no_firewood",
            when: [(fact: "firewood_stock", op: "==", value: Some(0))],
            text_key: "DIAG_SETTLEMENT_NO_FIREWOOD",
            params: {},
            severity: "danger",
            next: None,
            tags: ["warmth"],
        ),
        (
            id: "settlement_firewood_low",
            when: [(fact: "firewood_stock", op: "<", value: Some(10))],
            text_key: "DIAG_SETTLEMENT_FIREWOOD_LOW",
            params: {"firewood_count": "firewood_stock"},
            severity: "warning",
            next: None,
            tags: ["warmth"],
        ),
        (
            id: "settlement_no_idle_adults",
            when: [(fact: "idle_adult_count", op: "==", value: Some(0))],
            text_key: "DIAG_SETTLEMENT_NO_IDLE",
            params: {"adult_count": "adult_count"},
            severity: "notice",
            next: None,
            tags: ["labor"],
        ),
        (
            id: "settlement_no_ripe_plants",
            when: [
                (fact: "is_winter", op: "has", value: None),
                (fact: "ripe_plant_count", op: "==", value: Some(0)),
            ],
            text_key: "DIAG_SETTLEMENT_NO_RIPE_PLANTS",
            params: {},
            severity: "notice",
            next: None,
            tags: ["food", "winter"],
        ),
        (
            id: "settlement_no_stockpile",
            when: [(fact: "stockpile_count", op: "==", value: Some(0))],
            text_key: "DIAG_SETTLEMENT_NO_STOCKPILE",
            params: {},
            severity: "warning",
            next: None,
            tags: ["storage"],
        ),
    ]),
])
