  "verdicts": {
    "natural_cold_night": {
      "verdict": "NEEDS WORK",
      "reason": "Six frosted shelters, unlit ash hearth and cool tint are legible, but all three frosted-night contact sheets fail to show an identifiable repeated doorway-breath cycle. Earlier white puffs overlap the lit hearth projection and cannot be confidently called doorway breath."
    },
    "morning_after": {
      "verdict": "ACCEPT",
      "reason": "Morning images visibly restore warm daylight, remove frost edging, show residents outside and retain a distinct unlit hearth. This accepts the visible transition only, not hidden simulation recovery."
    },
    "carry_2x": {
      "verdict": "ACCEPT",
      "reason": "Staged 2x adult carrying silhouettes use waist/side loads distinct from hand-to-mouth eating; shoulder wood load is readable. Acceptance is limited to the two staged sheets, not runtime use."
    },
    "god_hand": {
      "verdict": "NEEDS WORK",
      "reason": "Rain streaks, cold wash and readable intervention panel/log are visible. Gift and spoil rely on textual feedback in these frames, and the two wind captures do not clearly expose a distinct windfall effect or its ending."
    }
  }
