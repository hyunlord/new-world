# person_read_cache.gd: per-tick cache for agent_inspector_panel.gd of agent_id -> entity bits and of per-person
#   bridge reads; raw dictionaries only, invalidated when the tick or world changes.
# Bridge methods: get_person, get_person_chronicle, get_agent_family, get_agent_temperament (direct);
#   via SimReads get_time_snapshot, get_agent_snapshot.
extends RefCounted
## Raw bridge data only. Localized sentences are generated by the consumer.
var _world: Node
var tick: int = -9223372036854775807
var entities: Dictionary = {}
var _reads: Dictionary = {}

func sync(world: Node) -> void:
	var now: int = 0
	if world != null and world.has_method("get_time_snapshot"):
		var clock: Dictionary = SimReads.read(world, "get_time_snapshot")
		now = int(clock.get("tick", 0))
	if world == _world and now == tick:
		return
	_world = world
	tick = now
	_reads.clear()
	entities.clear()
	if world == null or not world.has_method("get_agent_snapshot"):
		return
	var snapshot: Dictionary = SimReads.read(world, "get_agent_snapshot")
	var ids: PackedInt64Array = snapshot.get("ids", PackedInt64Array())
	var agents: PackedInt64Array = snapshot.get("agent_ids", PackedInt64Array())
	for index: int in mini(ids.size(), agents.size()):
		entities[int(agents[index])] = int(ids[index])

func reset() -> void:
	_world = null
	tick = -9223372036854775807
	entities.clear()
	_reads.clear()

func read(method: String, agent_id: int, entity_argument: bool = false) -> Dictionary:
	var key: String = "%s:%d" % [method, agent_id]
	if not _reads.has(key):
		var result: Dictionary = {}
		var argument: int = int(entities.get(agent_id, -1)) if entity_argument else agent_id
		if _world != null and argument >= 0 and _world.has_method(method):
			var value: Variant = {}
			match method:
				"get_person": value = _world.call("get_person", argument)
				"get_person_chronicle": value = _world.call("get_person_chronicle", argument)
				"get_agent_family": value = _world.call("get_agent_family", argument)
				"get_agent_temperament": value = _world.call("get_agent_temperament", argument)
			if value is Dictionary:
				result = value.duplicate(true)
		_reads[key] = result
	return _reads[key]
